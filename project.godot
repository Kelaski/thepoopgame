; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tag Rush"
config/description="Team-based objective FPS: grab the Tag, protect your Runner."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Net="*res://scripts/autoload/net.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="interior_floors"
3d_physics/layer_2="walls_furniture"
3d_physics/layer_3="players"
3d_physics/layer_4="doors"
3d_physics/layer_5="ground_fence"

[physics]

common/max_physics_steps_per_frame=4

[rendering]

lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.88, 1)
anti_aliasing/quality/screen_space_aa=1
