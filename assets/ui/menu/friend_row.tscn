[gd_scene format=3]

[node name="FriendRow" type="HBoxContainer"]
theme_override_constants/separation = 10

[node name="Name" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Friend"
clip_text = true
text_overrun_behavior = 3

[node name="Playing" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 14
text = "In Tag Rush"

[node name="InviteButton" type="Button" parent="."]
custom_minimum_size = Vector2(100, 38)
layout_mode = 2
text = "Invite"
