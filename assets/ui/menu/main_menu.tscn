[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/menu/main_menu.gd" id="e1"]
[ext_resource type="PackedScene" path="res://assets/ui/menu/server_browser.tscn" id="browser"]
[ext_resource type="PackedScene" path="res://assets/ui/menu/music_bar.tscn" id="music_bar"]


[node name="MainMenu" type="Control"]
script = ExtResource("e1")
anchor_right = 1
anchor_bottom = 1

[node name="Background" type="ColorRect" parent="."]
color = Color(0.04, 0.045, 0.06, 1)
anchor_right = 1
anchor_bottom = 1

[node name="Center" type="CenterContainer" parent="."]
mouse_filter = 2
anchor_right = 1
anchor_bottom = 1

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(440, 0)

[node name="Box" type="VBoxContainer" parent="Center/Panel"]
theme_override_constants/separation = 10

[node name="Heading" type="Label" parent="Center/Panel/Box" groups=["accent"]]
text = "TAG RUSH"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 66

[node name="Host" type="Button" parent="Center/Panel/Box"]
unique_name_in_owner = true
text = "Host Lobby"

[node name="Find" type="Button" parent="Center/Panel/Box"]
unique_name_in_owner = true
text = "Server Browser"

[node name="Settings" type="Button" parent="Center/Panel/Box"]
unique_name_in_owner = true
text = "Settings"

[node name="Quit" type="Button" parent="Center/Panel/Box"]
unique_name_in_owner = true
text = "Quit"

[node name="Message" type="Label" parent="Center/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
autowrap_mode = 3
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.68, 0.7, 0.75, 1)

[node name="MusicBar" parent="." instance=ExtResource("music_bar")]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
anchor_top = 1
anchor_bottom = 1
offset_left = 20
offset_top = -170
offset_right = 440
offset_bottom = -44
grow_vertical = 0

[node name="ServerBrowser" parent="." instance=ExtResource("browser")]
unique_name_in_owner = true
