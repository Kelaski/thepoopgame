[gd_scene format=3]

[node name="LobbyRow" type="PanelContainer"]
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Host" type="Label" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Host"
clip_text = true
text_overrun_behavior = 3

[node name="Players" type="Label" parent="Row"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 16
text = "1 / 16"
horizontal_alignment = 2

[node name="JoinButton" type="Button" parent="Row"]
custom_minimum_size = Vector2(110, 40)
layout_mode = 2
text = "Join"
